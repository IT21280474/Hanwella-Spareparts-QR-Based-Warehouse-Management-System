# Base URL of the Laravel API host. No trailing slash.
# Local dev: use "/" — Vite's dev server proxies /api and /sanctum to the
# backend (see vite.config.js), keeping requests same-origin so CORS and
# SameSite-cookie rules never come into play.
# Production: point this at the real API origin instead, e.g.
# https://api.hanwellaspares.lk — see docs/deployment/README.md.
VITE_API_URL=/

# Displayed alongside every monetary amount.
VITE_CURRENCY=Rs
